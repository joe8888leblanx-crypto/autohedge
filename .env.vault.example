# Vault + CockroachDB Configuration
# Copy this to .env.vault and fill in your values (DO NOT COMMIT .env.vault)

# CockroachDB Connection (Vault Storage Backend)
VAULT_DB_CONNECTION_URL=postgres://vault_user:vault_password@localhost:5432/vault

# Vault Server Configuration
VAULT_ADDR=https://127.0.0.1:8200
VAULT_TOKEN=your_vault_root_token_here
VAULT_SKIP_VERIFY=false

# TLS Certificates (for production)
VAULT_TLS_CERT_FILE=/etc/vault/tls/vault.crt
VAULT_TLS_KEY_FILE=/etc/vault/tls/vault.key

# CockroachDB User Credentials
COCKROACH_USER=vault_user
COCKROACH_PASSWORD=vault_password
COCKROACH_HOST=localhost
COCKROACH_PORT=5432
COCKROACH_DATABASE=vault

# AutoHedge Secrets Stored in Vault
AUTOHEDGE_WALLET_PRIVATE_KEY=secret/data/autohedge/wallet
AUTOHEDGE_JUPITER_API_KEY=secret/data/autohedge/jupiter
AUTOHEDGE_OPENAI_API_KEY=secret/data/autohedge/openai
AUTOHEDGE_ANTHROPIC_API_KEY=secret/data/autohedge/anthropic
